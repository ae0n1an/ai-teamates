# Copy to `.env` for `docker compose up`, or to `.env.local` for `npm run dev`.

# Required. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the app (used for OAuth callbacks and links in emails).
BETTER_AUTH_URL=http://localhost:3000

# Postgres. docker compose builds DATABASE_URL from these for the containers.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_teamates
# Only needed for `npm run dev` against the compose database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_teamates?schema=public

# Host port for the app container.
APP_PORT=3000
# Host port for the Adminer database UI.
ADMINER_PORT=8080

# OAuth (optional). Callback URLs: <BETTER_AUTH_URL>/api/auth/callback/google and /github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
